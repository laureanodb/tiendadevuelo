{
  "ignoreCommand": "node tests/revisar.mjs --vercel",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/producto/:id",
      "destination": "/api/ficha?tipo=producto&id=:id"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/ficha?tipo=categoria&id=:slug"
    },
    {
      "source": "/marca/:slug",
      "destination": "/api/ficha?tipo=marca&id=:slug"
    },
    {
      "source": "/ofertas",
      "destination": "/"
    },
    {
      "source": "/usados",
      "destination": "/"
    },
    {
      "source": "/novedades",
      "destination": "/"
    },
    {
      "source": "/carrito",
      "destination": "/"
    },
    {
      "source": "/catalogo.csv",
      "destination": "/api/catalogo"
    },
    {
      "source": "/liquidacion",
      "destination": "/"
    },
    {
      "source": "/google-shopping.tsv",
      "destination": "/api/catalogo?formato=google"
    }
  ],
  "redirects": [
    {
      "source": "/kit",
      "destination": "/#kits",
      "permanent": false
    },
    {
      "source": "/kits",
      "destination": "/#kits",
      "permanent": false
    },
    {
      "source": "/pedido",
      "destination": "/contacto#pedido",
      "permanent": false
    },
    {
      "source": "/arrepentimiento",
      "destination": "/legales#arrepentimiento",
      "permanent": false
    },
    {
      "source": "/auriculares",
      "destination": "/categoria/comunicaciones",
      "permanent": false
    },
    {
      "source": "/gps",
      "destination": "/categoria/avionica",
      "permanent": false
    },
    {
      "source": "/navegacion",
      "destination": "/categoria/navegacion",
      "permanent": false
    },
    {
      "source": "/accesorios",
      "destination": "/categoria/accesorios",
      "permanent": false
    },
    {
      "source": "/primer-vuelo",
      "destination": "/guia-primer-vuelo",
      "permanent": false
    },
    {
      "source": "/tripulantes",
      "destination": "/#tripulantes",
      "permanent": false
    },
    {
      "source": "/regalos",
      "destination": "/#regalos",
      "permanent": false
    }
  ],
  "functions": {
    "api/[fn].js": {
      "includeFiles": "{products.js,index.html}",
      "maxDuration": 60
    },
    "api/panel/[fn].js": {
      "includeFiles": "products.js",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/resumen",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/instagram",
      "schedule": "0 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw-panel.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/panel"
        }
      ]
    }
  ]
}
