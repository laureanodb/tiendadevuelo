{
  "ignoreCommand": "node tests/revisar.mjs --vercel",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/producto/:id",
      "destination": "/"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/"
    },
    {
      "source": "/marca/:slug",
      "destination": "/"
    },
    {
      "source": "/ofertas",
      "destination": "/"
    },
    {
      "source": "/usados",
      "destination": "/"
    },
    {
      "source": "/novedades",
      "destination": "/"
    },
    {
      "source": "/carrito",
      "destination": "/"
    },
    {
      "source": "/catalogo.csv",
      "destination": "/api/catalogo"
    },
    {
      "source": "/liquidacion",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/kit",
      "destination": "/#kits",
      "permanent": false
    },
    {
      "source": "/kits",
      "destination": "/#kits",
      "permanent": false
    },
    {
      "source": "/pedido",
      "destination": "/contacto#pedido",
      "permanent": false
    },
    {
      "source": "/arrepentimiento",
      "destination": "/legales#arrepentimiento",
      "permanent": false
    },
    {
      "source": "/auriculares",
      "destination": "/categoria/comunicaciones",
      "permanent": false
    },
    {
      "source": "/gps",
      "destination": "/categoria/avionica",
      "permanent": false
    },
    {
      "source": "/navegacion",
      "destination": "/categoria/navegacion",
      "permanent": false
    },
    {
      "source": "/accesorios",
      "destination": "/categoria/accesorios",
      "permanent": false
    },
    {
      "source": "/primer-vuelo",
      "destination": "/guia-primer-vuelo",
      "permanent": false
    },
    {
      "source": "/tripulantes",
      "destination": "/#tripulantes",
      "permanent": false
    },
    {
      "source": "/regalos",
      "destination": "/#regalos",
      "permanent": false
    }
  ],
  "functions": {
    "api/[fn].js": {
      "includeFiles": "products.js",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/resumen",
      "schedule": "0 23 * * *"
    }
  ]
}
